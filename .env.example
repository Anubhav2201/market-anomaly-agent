# Required
ANTHROPIC_API_KEY=sk-ant-...        # console.anthropic.com
TIINGO_API_KEY=...                  # tiingo.com/account/api/token - required for news (replaces the
                                     # earlier cryptocurrency.cv integration, which turned out to be
                                     # down due to the maintainer's own unpaid Vercel bill, not a real
                                     # API design - see DECISIONS.md ADR-016). Requires the paid Power
                                     # plan ($30/month, see ADR-018) - free tier does NOT include news.
                                     # fetchRecentNews returns [] and logs a warning if unset, rather
                                     # than throwing.

# Optional - pipeline degrades gracefully without these (signal skipped, not failed)
GROQ_API_KEY=gsk-...                # console.groq.com - enables the free-model semantic grounding check
ADANOS_API_KEY=...                  # adanos.org - enables Reddit crypto sentiment as a candidate source

# Optional - email delivery (fanout-svc). Defaults to Gmail's SMTP relay
# specifically because it requires NO new third-party signup - use an
# App Password (myaccount.google.com -> Security -> 2-Step Verification
# -> App Passwords), not your real Gmail password. Logs instead of
# sending if unset - see src/delivery/emailDelivery.ts. NOT recommended
# beyond solo/testing scale - see DECISIONS.md ADR-026.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password
ALERT_FROM_EMAIL=you@gmail.com      # defaults to SMTP_USER if unset

# GCP (only needed when running against Firestore/Pub/Sub, e.g. the
# microservices in services/ - not needed for the local src/demo.ts or
# src/testSignals.ts slices, which use an in-memory store)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json
