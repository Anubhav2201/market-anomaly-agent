# Required
ANTHROPIC_API_KEY=sk-ant-...        # console.anthropic.com
TIINGO_API_KEY=...                  # tiingo.com/account/api/token - required for news (replaces the
                                     # earlier cryptocurrency.cv integration, which turned out to be
                                     # down due to the maintainer's own unpaid Vercel bill, not a real
                                     # API design - see DECISIONS.md ADR-016). Free signup, no news
                                     # without this key set (fetchRecentNews returns [] and logs a
                                     # warning rather than throwing).

TIINGO_API_KEY=...                  # tiingo.com/account/api/token - required for news (replaces earlier cryptocurrency.cv integration, which is now deprecated)

# Optional - pipeline degrades gracefully without these (signal skipped, not failed)
GROQ_API_KEY=gsk-...                # console.groq.com - enables the free-model semantic grounding check
ADANOS_API_KEY=...                  # adanos.org - enables Reddit crypto sentiment as a candidate source

# GCP (only needed when running against Firestore/Pub/Sub, e.g. the
# microservices in services/ - not needed for the local src/demo.ts or
# src/testSignals.ts slices, which use an in-memory store)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json
